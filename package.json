{
  "name": "@terminal-research/aion-chat-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./styles.css": "./dist/styles.css",
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/apollo.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run example:build",
    "example:build": "npm --workspace @terminal-research/aion-chat-react-example-inline-bootstrap run build",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "workspaces": [
    "examples/*"
  ],
  "peerDependencies": {
    "@apollo/client": "^3.14.0",
    "graphql": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "graphql": "^16.14.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
