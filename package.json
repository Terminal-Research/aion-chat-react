{
  "name": "@terminal-research/aion-chat-react",
  "version": "0.1.0",
  "description": "Aion React components and transports for agent chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terminal-Research/aion-chat-react.git"
  },
  "homepage": "https://github.com/Terminal-Research/aion-chat-react#readme",
  "bugs": {
    "url": "https://github.com/Terminal-Research/aion-chat-react/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "BUNDLE_BUDGETS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/direct.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./uploads": {
      "types": "./dist/uploads/index.d.ts",
      "import": "./dist/uploads.js"
    },
    "./storage/browser": {
      "types": "./dist/storage/browser.d.ts",
      "import": "./dist/storage/browser.js"
    },
    "./styles.css": "./dist/styles.css",
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/apollo.js"
    },
    "./graphql/standalone": {
      "types": "./dist/graphql/standalone.d.ts",
      "import": "./dist/graphql/standalone.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "npm run check:code && npm run check:artifacts",
    "check:artifacts": "npm run build && npm run check:distribution",
    "check:code": "npm run lint && npm run typecheck && npm test",
    "check:distribution": "npm run package:check && npm run example:build",
    "example:build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "package:check": "node scripts/validate-package.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "workspaces": [
    "examples/*"
  ],
  "peerDependencies": {
    "@apollo/client": "^3.14.0",
    "graphql": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "graphql": "^16.14.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "graphql-ws": "^6.0.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
